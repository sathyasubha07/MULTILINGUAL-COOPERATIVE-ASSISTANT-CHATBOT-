# Cooperative AI Portal Environment Configuration
PORT=8000
HOST=0.0.0.0
ENV=development
APP_NAME="Multilingual Cooperative Governance & Legal Assistance Portal"
API_V1_STR="/api/v1"

# LLM Providers (Plug any: Groq, Gemini, Ollama, OpenAI)
GROQ_API_KEY=""
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""
DEFAULT_LLM_PROVIDER="gemini" # options: gemini, groq, ollama, local_rule_rag

# Language & Speech Translation (Bhashini / Google / Local Web Speech)
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
BHASHINI_PIPELINE_ID=""
DEFAULT_LANGUAGE="hi" # Default to Hindi / English

# Vector Store & Cache
VECTOR_STORE_PATH="./database/vector_db"
OFFLINE_MODE=false
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
